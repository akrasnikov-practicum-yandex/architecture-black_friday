                <mxCell id="s12" value="shard1-2&lt;br&gt;(Вторичный)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" parent="g_s1" vertex="1">
                    <mxGeometry x="40" y="100" width="140" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="s13" value="shard1-3&lt;br&gt;(Вторичный)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" parent="g_s1" vertex="1">
                    <mxGeometry x="40" y="180" width="140" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="g_s2" value="Replica Set Shard 2" style="swimlane;horizontal=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" parent="1" vertex="1">
