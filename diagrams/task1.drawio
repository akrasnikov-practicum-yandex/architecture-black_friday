                    <mxGeometry x="40" y="180" width="140" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="legend1" value="&lt;b&gt;Почему 3 сервера конфигурации?&lt;/b&gt;&lt;br&gt;Начиная с MongoDB 3.2, серверы конфигурации разворачиваются как Replica Set (CSRS). Необходимо минимум 3 узла для кворума: это обеспечивает отказоустойчивость (High Availability). Без кворума кластер MongoDB не сможет выбирать Primary-узел, обновлять метаданные и балансировать чанки." style="text;html=1;strokeColor=#d79b00;fillColor=#ffe6cc;align=left;verticalAlign=top;whiteSpace=wrap;rounded=1;fontColor=#000000;spacingLeft=10;spacingTop=10;spacingRight=10;spacingBottom=10;" parent="1" vertex="1">
                    <mxGeometry x="900" y="100" width="250" height="120" as="geometry"/>
                </mxCell>
                <mxCell id="g_s1" value="Replica Set Shard 1" style="swimlane;horizontal=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" parent="1" vertex="1">
                    <mxGeometry x="150" y="380" width="220" height="260" as="geometry"/>
                </mxCell>
                <mxCell id="s11" value="shard1-1&lt;br&gt;(Первичный)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" parent="g_s1" vertex="1">
                    <mxGeometry x="40" y="20" width="140" height="60" as="geometry"/>
